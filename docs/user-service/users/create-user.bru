meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{user_service_url}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "developer@example.com",
    "name": "Jane Doe",
    "role": "ENGINEER"
  }
}
