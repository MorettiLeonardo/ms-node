meta {
  name: Update User
  type: http
  seq: 4
}

put {
  url: {{user_service_url}}/api/v1/users/{{user_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Jane W. Doe",
    "role": "LEAD_ENGINEER"
  }
}
