meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{auth_service_url}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "user@example.com",
    "password": "Password123!"
  }
}

vars:post-response {
  access_token: res.body.data.tokens.access_token
  refresh_token: res.body.data.tokens.refresh_token
}
