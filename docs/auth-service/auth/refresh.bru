meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{auth_service_url}}/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

vars:post-response {
  access_token: res.body.data.access_token
  refresh_token: res.body.data.refresh_token
}
